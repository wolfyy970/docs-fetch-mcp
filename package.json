{
  "name": "docs-fetch-mcp",
  "version": "1.0.0",
  "description": "MCP server for fetching web page content with recursive exploration capability",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "docs-fetch-mcp": "build/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=bun --format=esm --packages=external --outfile=build/index.js && chmod +x build/index.js",
    "start": "bun build/index.js",
    "dev": "bun src/index.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "llm",
    "claude",
    "documentation",
    "web-crawler"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "axios": "^1.8.4",
    "cheerio": "1.0.0",
    "puppeteer": "^21.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
